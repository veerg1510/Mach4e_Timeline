    }
  }
  sctx.font = `400 11px ${FONT_M}`; sctx.fillStyle = K.muted; sctx.textBaseline = 'alphabetic';
  sctx.textAlign = 'left'; sctx.fillText('0 s', 4, 12);
  sctx.textAlign = 'right'; sctx.fillText(fmt(tr.Tc), SW - 4, 12);
  sctx.textAlign = 'left'; sctx.fillText('teal bars: saved PCI files that captured this row (30 min run)', 4, SH - 6);
  const burst = tr.rows.filter(r => r.W > 0);
  if (burst.length > 1){
    const bx = xs(burst[burst.length - 1].off + burst[burst.length - 1].pri);
    sctx.fillStyle = K.muted; sctx.textAlign = 'left';
    if (SW - bx > 140) sctx.fillText(`rows ${burst.length}–${tr.rows.length - 1}: 0 W`, bx + 10, base - 10);
  }
}
function updateRun(){
  run = runCount(S.pr, prm);
  const groups = new Map();
  for (const [i, c] of run.counts){
    const r = S.train.rows[i]; const key = r.W > 0 ? FOLDER(r.pd) : '0 W (no pulse)';
    groups.set(key, (groups.get(key) || 0) + c);
  }
  const order = ['4ms', '5ms', '7ms', '8ms'];
  const keys = [...groups.keys()].sort((a, b) => (order.indexOf(a) + 9) % 9 - (order.indexOf(b) + 9) % 9);
  $('counts').innerHTML = `<span>30 min run: <b>${run.total}</b> saved PCI files</span>` + keys.map(k => `<span>${k}: <b>${groups.get(k)}</b></span>`).join('');
  drawStrip();
}

/* ---------- rebuild ---------- */
function rebuild(keepStep){
  S = simulate(PROTOCOLS[prm.scheme], prm, 3);
  usedMap = new Map(S.used.map(u => [usedKey(u.t), u]));
  tour = buildTour();
  $('chapters').innerHTML = tour.map((s, i) => `<button class="chap" type="button" data-i="${i}" title="${esc(s.title)}">${i + 1} · ${esc(s.title.length > 26 ? s.title.slice(0, 24) + '…' : s.title)}</button>`).join('');
  buildFindings(); buildTable();
  goStep(keepStep ? step : 0, true);
  if (mode === 'free') setMode('paused');
}

/* ---------- loop ---------- */
let lastT = performance.now();
const ease = u => u < 0.5 ? 2 * u * u : 1 - Math.pow(-2 * u + 2, 2) / 2;
function frame(now){
  const dt = Math.min(0.1, (now - lastT) / 1000); lastT = now;
  if (mode === 'tour'){
    stepT += dt; const s = tour[step], u = Math.min(1, stepT / s.dur);
    playhead = s.from + (s.to - s.from) * ease(u);
    if (stepT > s.dur + 2.2){ if (step < tour.length - 1) goStep(step + 1); else setMode('paused'); }
    dirty = true; updateNow();
  } else if (mode === 'free'){
    playhead += dt * speed;
    const end = S.loops[S.loops.length - 1].end;
    if (playhead > end){ playhead = 0; }
    const span = view.b - view.a;
    if (!anim && (playhead > view.b - 0.08 * span || playhead < view.a)) view = {a:playhead - 0.25 * span, b:playhead + 0.75 * span};
    dirty = true; updateNow();
  }
  if (anim){
    anim.t += dt / 1.1; const u = ease(Math.min(1, anim.t));
    const c0 = (anim.from.a + anim.from.b) / 2, c1 = (anim.to.a + anim.to.b) / 2;
    const s0 = anim.from.b - anim.from.a, s1 = anim.to.b - anim.to.a;
    const sp = Math.exp(Math.log(s0) * (1 - u) + Math.log(s1) * u), c = c0 + (c1 - c0) * u;
    view = {a:c - sp / 2, b:c + sp / 2};
    if (anim.t >= 1){ view = {...anim.to}; anim = null; }
    dirty = true;
  }
  if (dirty){ draw(); dirty = false; }
  requestAnimationFrame(frame);
}

/* ---------- interaction ---------- */
function zoomAt(x, f){
  const t = Tat(x), span = (view.b - view.a) * f;
  const clamped = Math.min(Math.max(span, 0.05), 60000);
  const r = (x - gut) / plotW();
  view = {a:t - r * clamped, b:t + (1 - r) * clamped}; anim = null; dirty = true;
}
const ptrs = new Map(); let drag = null, pinch = null;
wrapEl.addEventListener('pointerdown', e => {
  wrapEl.setPointerCapture(e.pointerId);
  ptrs.set(e.pointerId, {x:e.offsetX, y:e.offsetY});
  if (ptrs.size === 1) drag = {x:e.offsetX, v:{...view}, moved:false};
  if (ptrs.size === 2){ const [a, b] = [...ptrs.values()]; pinch = {d:Math.abs(a.x - b.x) || 1, v:{...view}, mid:(a.x + b.x) / 2}; drag = null; }
});
wrapEl.addEventListener('pointermove', e => {
  if (!ptrs.has(e.pointerId)) return;
  ptrs.set(e.pointerId, {x:e.offsetX, y:e.offsetY});
