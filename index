/* ---------- readout ---------- */
function nowRows(t){
  const tr = S.train, rows = [];
  const at = tr.at(t), into = t - at.s;
  let ek;
  if (at.r.W > 0 && into < at.r.pd) ek = `Firing: row ${at.r.i}, ${at.r.W} W, ${fmt(into)} into a ${at.r.pd} ms pulse`;
  else if (at.r.W === 0) ek = `Row ${at.r.i}: 0 W, silent`;
  else ek = `Off after row ${at.r.i}. Next row in ${fmt(at.s + at.r.pri - t)}`;
  rows.push(['ekos', 'EKOS', ek]);
  const pv = tr.prevTrig(t), u = usedMap.get(usedKey(pv.s));
  rows.push(['ink', 'Trigger', `Last edge ${fmt(t - pv.s)} ago (row ${pv.r.i})` + (u ? `, taken by Event ${u.ev} (${u.what})` : ', ignored: nothing was waiting')]);
  let sq = null; for (const s of S.seq) if (t >= s.a && t < s.b) sq = s;
  rows.push(['muted', 'Sequencer', sq ? `${sq.label} (Event ${sq.ev})` : 'Starting the next event']);
  let bm = '—';
  for (const f of S.frames) if (t >= f.a && t <= f.b){
    const j = Math.min(NLINES, Math.floor((t - f.a) / LINE_SLOT) + 1), ph = (t - f.a) - (j - 1) * LINE_SLOT;
    const on = f.row.W > 0 && (t - f.a) < f.row.pd;
    bm = `Frame ${f.i}, line ${j} of 128, ${ph < LINE_RX ? 'receiving echoes' : 'idle until the next line'}` + (on ? `, EKOS on at ${f.row.W} W` : '');
  }
