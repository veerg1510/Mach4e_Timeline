    const [a, b] = [...ptrs.values()], d = Math.abs(a.x - b.x) || 1;
    const span = Math.min(Math.max((pinch.v.b - pinch.v.a) * pinch.d / d, 0.05), 60000);
    const r = (pinch.mid - gut) / plotW(), tm = pinch.v.a + r * (pinch.v.b - pinch.v.a);
    view = {a:tm - r * span, b:tm + (1 - r) * span}; anim = null; dirty = true;
    if (mode !== 'paused') setMode('paused');
  } else if (drag){
    const dx = e.offsetX - drag.x;
    if (Math.abs(dx) > 4) drag.moved = true;
    if (drag.moved){
      const sh = dx / plotW() * (drag.v.b - drag.v.a);
      view = {a:drag.v.a - sh, b:drag.v.b - sh}; anim = null; dirty = true;
      if (mode === 'tour') setMode('paused');
    }
  }
});
function endPtr(e){
  if (!ptrs.has(e.pointerId)) return;
  if (drag && !drag.moved && ptrs.size === 1 && e.offsetX > gut){
    playhead = Tat(e.offsetX); if (mode === 'tour') setMode('paused'); updateNow(true); dirty = true;
  }
  ptrs.delete(e.pointerId);
  if (ptrs.size < 2) pinch = null;
  if (ptrs.size === 0) drag = null;
}
wrapEl.addEventListener('pointerup', endPtr);
wrapEl.addEventListener('pointercancel', endPtr);
wrapEl.addEventListener('wheel', e => {
  if (e.ctrlKey || e.metaKey){ e.preventDefault(); zoomAt(e.offsetX, Math.exp(e.deltaY * 0.01)); if (mode === 'tour') setMode('paused'); }
  else if (Math.abs(e.deltaX) > Math.abs(e.deltaY)){ e.preventDefault(); const sh = e.deltaX / plotW() * (view.b - view.a); view = {a:view.a + sh, b:view.b + sh}; dirty = true; if (mode === 'tour') setMode('paused'); }
}, {passive:false});

$('tourBtn').onclick = () => {
  if (mode === 'tour'){ setMode('paused'); return; }
  const s = tour[step];
  if (step === tour.length - 1 && stepT >= s.dur) goStep(0); else if (stepT === 0 || Math.abs(view.a - s.view[0]) > 1e-9) goStep(step);
  setMode('tour');
};
$('prevBtn').onclick = () => { goStep(step - 1); };
$('nextBtn').onclick = () => { goStep(step + 1); };
$('chapters').onclick = e => { const b = e.target.closest('button'); if (b) goStep(+b.dataset.i); };
$('freeBtn').onclick = () => setMode(mode === 'free' ? 'paused' : 'free');
$('speed').onchange = e => { speed = +e.target.value; };
$('preset').onchange = e => {
  const v = e.target.value; e.target.value = ''; if (!v) return;
  const f0 = S.frames[0], p0 = S.pcis[0], L0 = S.loops[0], L1 = S.loops[1];
  const m = {loop:[-40, L0.end + 160], two:[-40, L1.end + 200], frame:[f0.a - 2, f0.b + 3], line:[f0.a - 0.05, f0.a + 0.47], pci:[p0.a - 2, p0.b + 3], win:[p0.a - 0.08, p0.a + 0.75]}[v];
  if (mode === 'tour') setMode('paused');
  animateView(m[0], m[1]);
};
$('zin').onclick = () => { zoomAt(gut + plotW() / 2, 0.5); };
$('zout').onclick = () => { zoomAt(gut + plotW() / 2, 2); };

function bindRange(id, key, out, f){
  const el = $(id);
  const upd = () => { prm[key] = +el.value; $(out).textContent = f(+el.value); };
  upd();
  return {el, upd};
}
const cycleLen = () => makeTrain(PROTOCOLS[prm.scheme], 0, false).Tc;
const phaseR = bindRange('phase', 'phasePct', 'phaseOut', v => fmt(v / 100 * cycleLen()) + ' into the cycle');
const hostR = bindRange('hostPCI', 'hostPCI', 'hostPCIOut', v => fmt(v));
const hostBR = bindRange('hostB', 'hostB', 'hostBOut', v => fmt(v));
let rebuildTimer = null;
function scheduleRebuild(){
  clearTimeout(rebuildTimer);
  rebuildTimer = setTimeout(() => { rebuild(true); updateRun(); }, 80);
}
phaseR.el.oninput = () => { phaseR.upd(); scheduleRebuild(); };
hostR.el.oninput = () => { hostR.upd(); scheduleRebuild(); };
hostBR.el.oninput = () => { hostBR.upd(); scheduleRebuild(); };
$('scheme').onchange = e => { prm.scheme = e.target.value; phaseR.upd(); scheduleRebuild(); };
$('trigAll').onchange = e => { prm.trigAll = e.target.value === '1'; scheduleRebuild(); };

/* ---------- boot ---------- */
readTokens();
const mq = window.matchMedia('(prefers-color-scheme: dark)');
if (mq.addEventListener) mq.addEventListener('change', () => { readTokens(); drawStrip(); });
new MutationObserver(() => { readTokens(); drawStrip(); }).observe(document.documentElement, {attributes:true, attributeFilter:['data-theme']});
layout();
rebuild(false);
updateRun();
new ResizeObserver(() => { layout(); drawStrip(); }).observe(wrapEl);
if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { dirty = true; drawStrip(); });
requestAnimationFrame(frame);
})();
</script>

