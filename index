let K = {};
function readTokens(){
  const cs = getComputedStyle(document.documentElement);
  for (const n of ['paper','panel','ink','muted','line','grid','chip','ekos','bmode','pci','host','warn','ok'])
    K[n] = cs.getPropertyValue('--' + n).trim();
