/* ---------- sequence strip ---------- */
let SW = 0, SH = 150, run = null;
function layoutStrip(){
  SW = st.parentElement.clientWidth - 32;
  st.width = Math.round(SW * dpr); st.height = Math.round(SH * dpr); st.style.height = SH + 'px';
}
function drawStrip(){
  if (!S || !run) return;
  const tr = S.train;
  sctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  sctx.fillStyle = K.panel; sctx.fillRect(0, 0, SW, SH);
  const xs = t => 4 + t / tr.Tc * (SW - 8), base = 92, full = 70;
  sctx.strokeStyle = K.grid; sctx.beginPath(); sctx.moveTo(0, base + 0.5); sctx.lineTo(SW, base + 0.5); sctx.stroke();
  const maxC = Math.max(1, ...run.counts.values());
  for (const r of tr.rows){
    const x0 = xs(r.off), x1 = xs(r.off + r.pd), w = Math.max(2, x1 - x0);
    if (r.W === 0){ sctx.fillStyle = rgba(K.muted, 0.4); sctx.fillRect(x0, base - 2, w, 2); }
    else {
      const hh = full * r.W / MAXW;
      sctx.fillStyle = rgba(K.ekos, 0.35); sctx.fillRect(x0, base - hh, w, hh);
      sctx.fillStyle = K.ekos; sctx.fillRect(x0, base - hh, w, 2);
    }
    const c = run.counts.get(r.i) || 0;
    if (c){
      const ch = 28 * c / maxC;
