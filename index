<body>

<div class="wrap">
  <header>
    <div class="eyebrow">Verasonics Vantage NXT · L11-5v · EKOS Definity · SetUpL115_PCI_260925</div>
    <h1>When every pulse fires, and what records it</h1>
    <p class="lede">A replay of one acquisition loop from your NXT setup script, aligned to the EKOS therapy pulses. Play the tour to step through it, or drag and zoom the timeline yourself. Every time on the page is computed from the script's own parameters; the few guesses are listed at the bottom and can be changed in the settings.</p>
    <dl class="consts" id="consts"></dl>
  </header>

  <section class="player" aria-label="Acquisition timeline">
    <div class="bar">
      <button class="primary" id="tourBtn" type="button">Play tour</button>
      <button id="prevBtn" type="button" aria-label="Previous step">Prev</button>
      <button id="nextBtn" type="button" aria-label="Next step">Next</button>
      <span class="sep"></span>
      <button id="freeBtn" type="button">Run freely</button>
      <select id="speed" aria-label="Playback speed">
        <option value="1">1/1000 of real time</option>
        <option value="5">1/200 of real time</option>
        <option value="20" selected>1/50 of real time</option>
        <option value="100">1/10 of real time</option>
        <option value="1000">Real time</option>
      </select>
      <select id="preset" aria-label="Zoom to">
        <option value="">Zoom to…</option>
        <option value="loop">Whole loop</option>
        <option value="two">Two loops</option>
        <option value="frame">B-mode frame 1</option>
        <option value="line">First 3 B-mode lines</option>
        <option value="pci">PCI frame 1</option>
        <option value="win">First 0.75 ms of PCI</option>
      </select>
      <button id="zin" type="button" aria-label="Zoom in">+</button>
      <button id="zout" type="button" aria-label="Zoom out">−</button>
    </div>
    <div class="tlwrap" id="tlwrap"><canvas id="tl" role="img" aria-label="Timing diagram with lanes for EKOS pulses, trigger, sequencer, B-mode, PCI receive, MATLAB host and saved files"></canvas></div>
    <div class="legend" aria-label="Line legend">
      <span><svg width="30" height="10" aria-hidden="true"><line x1="1" y1="5" x2="29" y2="5" stroke="var(--pci)" stroke-width="1.6" stroke-dasharray="2 3"/></svg>PCI file ← the PCI record it holds</span>
      <span><svg width="30" height="10" aria-hidden="true"><line x1="1" y1="5" x2="29" y2="5" stroke="var(--bmode)" stroke-width="1.6" stroke-dasharray="2 3"/></svg>B-mode file ← the frame it holds</span>
      <span><svg width="30" height="10" aria-hidden="true"><line x1="1" y1="5" x2="29" y2="5" stroke="var(--ok)" stroke-width="2"/></svg>Correct pair: same loop</span>
      <span><svg width="30" height="10" aria-hidden="true"><line x1="1" y1="5" x2="29" y2="5" stroke="var(--warn)" stroke-width="2" stroke-dasharray="5 4"/></svg>Pair the timestamp rule picks: previous loop</span>
    </div>
    <div class="hint">Drag to pan. Pinch, or Ctrl + scroll, to zoom. Click to move the playhead. Time is measured from Event 1 of the first loop.</div>
    <div class="caption">
      <div class="cap" aria-live="polite">
        <div class="stepno" id="stepNo"></div>
        <h3 id="stepTitle"></h3>
        <p id="stepText"></p>
      </div>
      <div class="now">
        <h4>At the playhead · <span id="nowT"></span></h4>
        <dl class="nowlist" id="nowList"></dl>
      </div>
    </div>
    <div class="chapters" id="chapters" aria-label="Tour steps"></div>
    <div class="settings">
      <label class="f" for="scheme"><span class="top">EKOS protocol</span>
        <select id="scheme">
          <option value="mach4e">MACH4e acoustic sequence (30 rows, 1.40 s cycle)</option>
          <option value="p1">3 ms · 50 Hz · 18 W (pulsescheme 1)</option>
          <option value="p2">15 ms · 10 Hz · 18 W (needs lengthekos 34000)</option>
        </select>
      </label>
      <label class="f" for="trigAll"><span class="top">EKOS sends a trigger on</span>
        <select id="trigAll">
          <option value="0" selected>Powered rows only (assumed)</option>
          <option value="1">Every row, including the 0 W rows</option>
        </select>
      </label>
      <label class="f" for="phase"><span class="top">Sequence position at loop start <output id="phaseOut"></output></span>
        <input id="phase" type="range" min="0" max="99" step="1" value="0"></label>
      <label class="f" for="hostPCI"><span class="top">savepci1 run time (assumed) <output id="hostPCIOut"></output></span>
        <input id="hostPCI" type="range" min="100" max="6000" step="50" value="1200"></label>
      <label class="f" for="hostB"><span class="top">savebmode run time (assumed) <output id="hostBOut"></output></span>
        <input id="hostB" type="range" min="10" max="1000" step="10" value="60"></label>
    </div>
  </section>

  <section>
    <h2>The MACH4e acoustic sequence</h2>
    <div class="panel">
      <div class="strip-head">
        <p class="small" style="max-width:70ch">One cycle of the sequence table: rows 0–5 are six powered pulses in 254 ms, rows 6–29 are 0 W, and the cycle repeats every 1.397 s. Bar height is power, bar width is pulse length. The counts below replay a 30 min run with the current settings and show which pulse each saved PCI file captured. That is what sorts files into the 4ms, 5ms, 7ms and 8ms folders.</p>
      </div>
      <canvas id="strip" role="img" aria-label="MACH4e acoustic sequence, one cycle, with the number of saved PCI files per row"></canvas>
      <div class="counts" id="counts"></div>
    </div>
  </section>

  <section>
    <h2>What the timeline shows</h2>
    <div class="findings" id="findings"></div>
  </section>

  <section>
    <h2>Event log for the first loop</h2>
    <p class="small" style="margin-bottom:10px">Event numbers are the indices into the script's <code>Event</code> array. Select a row to jump the timeline there.</p>
    <div class="tablewrap"><table>
      <thead><tr><th>Time</th><th>Event</th><th>Lane</th><th>What happens</th></tr></thead>
      <tbody id="evbody"></tbody>
    </table></div>
  </section>

  <section class="prose">
    <h2>Assumptions and sources</h2>
    <ul>
      <li>Pulse power, width and PRI come from the MACH4e acoustic sequence table (rows 0–29). Each row's PRI is taken as the time from that row's start to the next row's start. Suarez Escudero et al. (2023) state the scanner was triggered by the EKOS driving unit at the start of each pulse. Whether the 0 W rows also send a trigger is not known, so it is a setting. Trigger latency is taken as zero.</li>
      <li>A <code>triggerIn</code> wait starts once the previous <code>timeToNextAcq</code> has elapsed, so edges that arrive earlier are ignored.</li>
      <li>The sequence does not resume until <code>savepci1</code> and <code>savebmode</code> return. Their run times are guesses. The spacing of your <code>190503trig1pos1_</code> filename stamps gives the real loop period.</li>
      <li>Reconstruction and transfer blocks are drawn short and not to scale. L11-5v pitch 0.30 mm, c = 1540 m/s, 31.25 MHz sampling (NS200BW at 7.8125 MHz).</li>
      <li>Filename stamps use an example clock of 14:03:27.500. The script writes milliseconds since midnight with 8 digits.</li>
    </ul>
    <p>Source: <a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC10581030/" target="_blank" rel="noopener">Quantifying the effect of acoustic parameters on temporal and spatial cavitation activity: Gauging cavitation dose (PMC10581030)</a></p>
  </section>
</div>

<script>
(() => {
/*SIM-START*/
const LINE_SLOT = 0.142, LINE_RX = 0.092416, NLINES = 128;
const WAIT_DELAY = 32.7, WAIT_FRAME = 60.142, WAIT_PCI = 15.7;
const FS_PER_MS = 31250, LIVE_A = 0.288, LIVE_B = 0.576, F_EKOS = 2250; // cycles per ms
const BASE_MS = 50607500; // 14:03:27.500 as milliseconds since midnight
const MAXW = 47.28;
// MACH4e acoustic sequence table: [power W, pulse width ms, PRI ms]
const MACH4E_ROWS = [[9.00, 8.06, 47.62], [15.00, 5.00, 37.04], [30.00, 6.86, 47.62], [47.28, 4.00, 37.04], [30.00, 6.86, 47.62], [15.00, 5.00, 37.04]]
  .concat(Array.from({length:24}, () => [0, 1.00, 47.62]));
const PROTOCOLS = {
  mach4e:{name:'MACH4e', rows:MACH4E_ROWS, rec:8.892416, ns:277888},
  p1:{name:'3 ms · 50 Hz protocol', rows:[[18, 3.0, 20]], rec:4.001792, ns:125056},
  p2:{name:'15 ms · 10 Hz protocol', rows:[[18, 15.0, 100]], rec:15.11424, ns:472320}
};
const FOLDER = pd => pd >= 7.5 ? '8ms' : pd >= 6 ? '7ms' : pd >= 4.5 ? '5ms' : pd >= 3.5 ? '4ms' : pd + ' ms';

function makeTrain(pr, phasePct, trigAll){
  const rows = pr.rows.map((r, i) => ({i, W:r[0], pd:r[1], pri:r[2]}));
  let off = 0; for (const r of rows){ r.off = off; off += r.pri; }
  const Tc = off, phi = phasePct / 100 * Tc;
  const trig = rows.filter(r => trigAll || r.W > 0);
  const minPri = Math.min(...rows.map(r => r.pri));
  return {rows, Tc, phi, trigAll, minPri,
    sends: r => trigAll || r.W > 0,
    pulsesIn(a, b, max = 6000){
      const out = []; const k0 = Math.floor((a - phi) / Tc) - 1, k1 = Math.floor((b - phi) / Tc) + 1;
      for (let k = k0; k <= k1 && out.length < max; k++) for (const r of rows){
        const s = phi + k * Tc + r.off; if (s + r.pd >= a && s <= b) out.push({s, e:s + r.pd, r, k});
      }
      return out;
    },
    nextTrig(t){
      for (let k = Math.floor((t - phi) / Tc) - 1; ; k++)
        for (const r of trig){ const s = phi + k * Tc + r.off; if (s >= t - 1e-9) return {s, r, k}; }
    },
    prevTrig(t){
      for (let k = Math.floor((t - phi) / Tc) + 1; ; k--)
        for (let j = trig.length - 1; j >= 0; j--){ const r = trig[j], s = phi + k * Tc + r.off; if (s <= t + 1e-9) return {s, r, k}; }
    },
    at(t){
      const k = Math.floor((t - phi) / Tc), u = t - phi - k * Tc;
      let r = rows[0]; for (const x of rows) if (x.off <= u) r = x;
      return {r, s:phi + k * Tc + r.off, k};
    }
  };
}
const rowTag = r => r.W > 0 ? `row ${r.i}, ${r.W} W, ${r.pd} ms` : `row ${r.i}, 0 W`;

function simulate(pr, prm, nLoops){
  const train = makeTrain(pr, prm.phasePct, prm.trigAll);
  const S = {train, pr, seq:[], dummy:[], frames:[], pcis:[], host:[], files:[], xfer:[], loops:[], used:[]};
  let t = 0, nextAcq = 0;
  for (let L = 0; L < nLoops; L++){
    const lp = {L, start: Math.max(t, nextAcq)};
    for (let i = 1; i <= 4; i++){
      const ev0 = 131 * (i - 1);
      const tD = Math.max(nextAcq, t);
      S.dummy.push({t:tD, L, i, ev:ev0 + 1});
      S.seq.push({a:tD, b:tD + WAIT_DELAY, type:'wait', label:'timeToNextAcq 32.7 ms', ev:ev0 + 1});
      nextAcq = tD + WAIT_DELAY;
      const tr = train.nextTrig(nextAcq), trig = tr.s;
      if (trig > nextAcq + 1e-6) S.seq.push({a:nextAcq, b:trig, type:'trig', label:'triggerIn: waiting for an EKOS edge', ev:ev0 + 2});
      const last = trig + (NLINES - 1) * LINE_SLOT, end = last + LINE_RX;
      S.frames.push({a:trig, b:end, L, i, ev:ev0 + 2, row:tr.r});
      S.used.push({t:trig, L, what:'B-mode frame ' + i, ev:ev0 + 2, row:tr.r});
      S.seq.push({a:trig, b:end, type:'bmode', label:'B-mode frame ' + i + ' · 128 lines', ev:ev0 + 2});
      S.xfer.push({t:end, L, ev:ev0 + 130});
      S.host.push({a:end + 0.3, b:end + 0.3 + prm.recon, type:'recon', label:'imageDisplay, frame ' + i, L, i, ev:ev0 + 131});
      nextAcq = last + WAIT_FRAME;
      S.seq.push({a:end, b:nextAcq, type:'wait', label:'timeToNextAcq 60.142 ms', ev:ev0 + 129});
      t = last;
    }
    for (let k = 1; k <= 2; k++){
      const ev = 524 + 2 * k - 1;
      const tr = train.nextTrig(nextAcq), trig = tr.s;
      if (trig > nextAcq + 1e-6) S.seq.push({a:nextAcq, b:trig, type:'trig', label:'triggerIn: waiting for an EKOS edge', ev});
      S.pcis.push({a:trig, b:trig + pr.rec, L, k, ev, saved:k === 1, row:tr.r});
      S.used.push({t:trig, L, what:'PCI frame ' + k, ev, row:tr.r});
      S.seq.push({a:trig, b:trig + pr.rec, type:'pci', label:'PCI frame ' + k + ' · passive receive', ev});
      S.xfer.push({t:trig + pr.rec, L, ev:ev + 1});
      nextAcq = trig + WAIT_PCI;
      if (k === 1) S.seq.push({a:trig + pr.rec, b:nextAcq, type:'wait', label:'timeToNextAcq 15.7 ms', ev});
      t = trig;
    }
    const p1 = S.pcis[S.pcis.length - 2], p2 = S.pcis[S.pcis.length - 1];
    const h0 = p2.b + 0.5, h1 = h0 + prm.hostPCI, h2 = h1 + prm.hostB;
    S.host.push({a:h0, b:h1, type:'savepci1', label:'savepci1: write PCI frame 1 to disk', L, ev:529});
    S.host.push({a:h1, b:h2, type:'savebmode', label:'savebmode: write the displayed B-mode', L, ev:531});
    S.files.push({t:h0 + 2, kind:'pci', L, src:p1});
    S.files.push({t:h1 + 1, kind:'bmode', L, src:S.frames[S.frames.length - 1]});
    S.seq.push({a:h0, b:h2, type:'host', label:'host busy: savepci1, returnToMatlab, savebmode', ev:529});
    t = h2; lp.end = h2; lp.hwEnd = p2.b; lp.h0 = h0; lp.h1 = h1;
    S.loops.push(lp);
  }
  for (const f of S.files){
    f.stamp = String(Math.floor(BASE_MS + f.t)).padStart(8, '0');
    f.name = f.kind === 'pci' ? '190503trig1pos1_' + f.stamp : 'Bmode' + f.stamp;
  }
  const bms = S.files.filter(f => f.kind === 'bmode'), pcs = S.files.filter(f => f.kind === 'pci');
  for (const p of pcs){
    let pick = null;
    for (const b of bms) if (Number(b.stamp) <= Number(p.stamp)) pick = b;
    p.compilerPick = pick || bms[0];
    p.truePick = bms.find(b => b.L === p.L);
  }
  return S;
}

// Replay a 30 min run and count which row each saved PCI file (frame 1) captured.
function runCount(pr, prm){
  const one = simulate(pr, prm, 1).loops[0].end;
  const n = Math.ceil(30 * 60 * 1000 / one) + 4;
  const S = simulate(pr, prm, n);
  const counts = new Map(); let total = 0;
  for (const p of S.pcis) if (p.saved && p.a <= 30 * 60 * 1000){ counts.set(p.row.i, (counts.get(p.row.i) || 0) + 1); total++; }
  return {counts, total, loopMean:S.loops[Math.min(S.loops.length - 1, 200)].end / Math.min(S.loops.length, 201)};
}
