function drawEkos(){
  const {y, h} = LY.ekos, base = y + h - 8, top = y + 8, full = base - top;
  const ps = S.train.pulsesIn(view.a, view.b);
  const cyclePx = pxPerMs() / F_EKOS;
  for (const p of ps){
    const xa = X(p.s), xb = X(p.e);
    if (xb < gut - 2 || xa > W) continue;
    if (p.r.W === 0){
      ctx.fillStyle = rgba(K.muted, 0.35); ctx.fillRect(xa, base - 2, Math.max(1, xb - xa), 2);
      if (xb - xa > 60) text('0 W', xa + 3, base - 10, {font:`400 10px ${FONT_D}`, color:K.muted, max:xb - xa - 4});
      continue;
    }
    const hh = Math.max(6, full * p.r.W / MAXW);
    ctx.fillStyle = rgba(K.ekos, 0.3); ctx.fillRect(xa, base - hh, Math.max(1.5, xb - xa), hh);
    ctx.fillStyle = K.ekos; ctx.fillRect(xa, base - hh, Math.max(1.5, xb - xa), 2);
    if (cyclePx >= 3.5){
      const ta = Math.max(p.s, view.a), tb = Math.min(p.e, view.b);
      const amp = hh / 2 - 3, cy = base - hh / 2;
      const n = Math.min(4000, Math.ceil((tb - ta) * F_EKOS * 14));
      ctx.strokeStyle = K.ekos; ctx.lineWidth = 1.2; ctx.beginPath();
      for (let i = 0; i <= n; i++){
        const t = ta + (tb - ta) * i / n, yy = cy - amp * Math.sin(2 * Math.PI * F_EKOS * (t - p.s));
