      while (s.length > 2 && ctx.measureText(s + '…').width > opts.max) s = s.slice(0, -1);
      if (s.length <= 2) return;
      s += '…';
    }
  }
  ctx.fillText(s, x, y);
}

/* ---------- drawing ---------- */
function niceStep(span, px){
  const target = span / Math.max(1, px / 92);
  const p = Math.pow(10, Math.floor(Math.log10(target)));
  for (const m of [1, 2, 5, 10]) if (m * p >= target) return m * p;
  return 10 * p;
}
function tickLabel(t, step){
  if (step >= 1000){ const d = Math.max(0, -Math.floor(Math.log10(step / 1000))); return (t / 1000).toFixed(d) + ' s'; }
  const d = Math.max(0, -Math.floor(Math.log10(step)));
  return t.toFixed(Math.min(4, d)) + ' ms';
}

function draw(){
